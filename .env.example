NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/trifid?replicaSet=rs0
MONGODB_DB_NAME=trifid

JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
# Developer addition — never read when NODE_ENV=production (see
# src/modules/identity/auth.service.ts). Lets every OTP in a non-production
# environment be this fixed code instead of a random one, so you don't have
# to read `devCode` back out of the API response while testing by hand.
OTP_DEV_FIXED_CODE=111111

STAFF_PASSWORD_MIN_LENGTH=12
STAFF_LOCKOUT_ATTEMPTS=5
STAFF_IDLE_TIMEOUT_MINUTES=30
STAFF_MFA_ISSUER=TriFid
# Developer addition — never read when NODE_ENV=production. Lets this exact
# code satisfy staff TOTP MFA (POST /auth/staff/mfa/verify and /auth/reauth)
# so you don't need an authenticator app for local development.
MFA_DEV_BYPASS_CODE=111111

WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_VERIFY_TOKEN=replace-me

FILE_STORAGE_ENDPOINT=http://localhost:9000
FILE_STORAGE_BUCKET=trifid-files
FILE_STORAGE_ACCESS_KEY=replace-me
FILE_STORAGE_SECRET_KEY=replace-me
FILE_MAX_BYTES=5242880
# Developer addition — added M3 for BankDetail.accountEncrypted. 32 raw
# bytes, base64. Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_DETAIL_ENCRYPTION_KEY=replace-me-with-a-real-32-byte-base64-key

QUEUE_URL=mongodb://localhost:27017/trifid?replicaSet=rs0
WORKER_HEARTBEAT_SECONDS=60

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=900
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# QR-028 — one-time seed script only (npm run seed:admin). Not read anywhere else.
SEED_ADMIN_EMAIL=admin@trifid.example
SEED_ADMIN_PASSWORD=replace-me-before-running
SEED_ADMIN_NAME=Founding Admin
