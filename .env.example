# Copy to `.env` and adjust:  copy .env.example .env
# Validated at boot by src/config/env.ts - the server won't start if a required value is missing or malformed.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on. 4000 matches the admin app's dev proxy (VITE_DEV_PROXY_TARGET).
PORT=4000

# REQUIRED. mongodb://... or mongodb+srv://...
# Must be a REPLICA SET (MongoDB Atlas is one by default) - money postings will use multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/trifid?replicaSet=rs0

# Allowed browser origins, comma-separated (no wildcard: credentials are enabled).
# 5173 is the Vite dev server of trifidadminapp. In dev the admin app goes through Vite's proxy, so this matters
# only when a browser calls the API directly (e.g. a deployed admin app on another domain).
CORS_ORIGIN=http://localhost:5173

# Max time (ms) to wait for in-flight requests to finish on SIGINT/SIGTERM before force-exit
SHUTDOWN_TIMEOUT_MS=10000
