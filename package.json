{
  "name": "trifid-serverapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TriFid API server foundation.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "check:mfa": "tsx src/scripts/checkMfaEnrolment.ts",
    "issue:mfa": "tsx src/scripts/issueMfa.ts",
    "seed:m5-demo": "tsx src/scripts/seedM5Demo.ts",
    "check:dead-list": "tsx src/scripts/checkDeadNames.ts",
    "drill:restore": "tsx src/scripts/backupRestoreDrill.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "npm run check:dead-list && vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "agenda": "^6.2.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
